{
  "expo": {
    "name": "TathirQuran",
    "slug": "tathirquran",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf5e9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fivesllc.tathirquran",
      "buildNumber": "14",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "TathirQuran sends you a daily Quran verse reminder each morning.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone.",
        "NSCameraUsageDescription": "This app does not use the camera.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fivesllc.tathirquran",
      "versionCode": 15,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf5e9"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withTathirQuranWidget",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6ED",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C3A56A",
          "sounds": [
            "./assets/sounds/azan_notification.wav"
          ],
          "mode": "production"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TathirQuran uses your location to calculate accurate Shia prayer times and the Qibla direction.",
          "locationWhenInUsePermission": "TathirQuran uses your location to calculate accurate Shia prayer times and the Qibla direction."
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "TathirQuran uses the camera only on the Qibla Finder screen, to show the direction of prayer over your surroundings. Nothing is photographed or recorded.",
          "microphonePermission": "TathirQuran does not use the microphone.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "scheme": "tathirquran",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a55110f4-4f77-4e70-bfd2-a9a40e13328e"
      },
      "iosAppStoreUrl": "https://apps.apple.com/app/tathirquran/id6811745113",
      "androidPlayStoreUrl": "https://play.google.com/store/apps/details?id=com.fivesllc.tathirquran"
    },
    "owner": "shakeelhussain"
  }
}
