{
  "expo": {
    "name": "TathirQuran",
    "slug": "tathirquran",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf5e9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fivesllc.tathirquran",
      "buildNumber": "5",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "TathirQuran sends you a daily Quran verse reminder each morning.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone.",
        "NSCameraUsageDescription": "This app does not use the camera.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fivesllc.tathirquran",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf5e9"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withTathirQuranWidget",
      "expo-asset",
      ["expo-splash-screen", {
        "backgroundColor": "#faf5e9",
        "image": "./assets/splash.png",
        "resizeMode": "contain"
      }],
      ["expo-notifications", {
        "icon": "./assets/icon.png",
        "color": "#c9a227",
        "sounds": [],
        "mode": "production"
      }],
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "TathirQuran uses your location to calculate accurate Shia prayer times.",
        "locationWhenInUsePermission": "TathirQuran uses your location to calculate accurate Shia prayer times."
      }]
    ],
    "scheme": "tathirquran",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a55110f4-4f77-4e70-bfd2-a9a40e13328e"
      },
      "iosAppStoreUrl": "https://apps.apple.com/app/tathirquran/id6811745113",
      "androidPlayStoreUrl": "https://play.google.com/store/apps/details?id=com.fivesllc.tathirquran"
    },
    "owner": "shakeelhussain"
  }
}
