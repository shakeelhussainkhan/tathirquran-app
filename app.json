{
  "expo": {
    "name": "TathirQuran",
    "slug": "tathirquran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf5e9",
    "splash": {
      "backgroundColor": "#1a1005",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fivesllc.tathirquran",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "TathirQuran sends a daily Quran verse notification"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1005"
      },
      "package": "com.fivesllc.tathirquran",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "plugins": ["expo-router", "expo-font"],
    "scheme": "tathirquran",
    "experiments": {
      "typedRoutes": true
    }
  }
}
