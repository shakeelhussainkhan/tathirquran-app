{
  "expo": {
    "name": "TathirQuran",
    "slug": "tathirquran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf5e9",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf5e9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fivesllc.tathirquran",
      "buildNumber": "2",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "TathirQuran sends a daily Quran verse notification",
        "NSMicrophoneUsageDescription": "This app does not use the microphone.",
        "NSCameraUsageDescription": "This app does not use the camera.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fivesllc.tathirquran",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf5e9"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "tathirquran",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a55110f4-4f77-4e70-bfd2-a9a40e13328e"
      },
      "iosAppStoreUrl": "https://apps.apple.com/app/tathirquran/id6811745113",
      "androidPlayStoreUrl": "https://play.google.com/store/apps/details?id=com.fivesllc.tathirquran"
    },
    "owner": "shakeelhussain"
  }
}
